# Copy this file to `keystore.properties` (same folder) and fill in real values.
# The real keystore.properties and the .jks file are gitignored — never commit them.
#
# Create the upload keystore once (from the android/ folder), then fill this in:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias superdub-upload
#
# Or let Android Studio's "Build > Generate Signed App Bundle" wizard create it.

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=superdub-upload
keyPassword=CHANGE_ME
